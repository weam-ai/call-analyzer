#############################################
# 🧠 BACKEND CONFIGURATION
#############################################

# Environment Mode (development/production)
NODE_ENV=development
PORT=5000

# Debug Mode (true/false) - Enable for debugging
DEBUG_MODE=true
DEBUG_LOGS=true

# Database (MongoDB)
# Option 1: Use single MongoDB URI (recommended)
MONOGODB_URI=

# Option 2: Use individual database variables (for MongoDB Atlas)
DB_CONNECTION=
DB_HOST=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_PORT=

# File Upload
MAX_FILE_SIZE=10485760          # 10 MB
UPLOAD_DIR=./uploads

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# CORS Configuration
CORS_ORIGIN=http://localhost:5003

# Gemini AI (Backend)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models


#############################################
# 💻 FRONTEND CONFIGURATION (Next.js)
#############################################

# Environment Mode (development/production)
NEXT_PUBLIC_ENVIRONMENT=development

# Debug Mode (true/false) - Enable for debugging
NEXT_PUBLIC_DEBUG_MODE=true

# Base Path for Deployment
NEXT_PUBLIC_BASE_PATH=/call-analyzer

# API Endpoint (Backend URL)
NEXT_PUBLIC_API_URL=http://localhost:5002/call-analyzer-api

# Cookie Configuration
NEXT_PUBLIC_COOKIE_NAME=weam
NEXT_PUBLIC_COOKIE_PASSWORD=your-random-cookie-password
#############################################
# 🧠 BACKEND CONFIGURATION
#############################################

# Environment
NODE_ENV=development
PORT=5000

# Database (MongoDB)
# Option 1: Use single MongoDB URI (recommended)
MONOGODB_URI=mongodb://localhost:27017/sales_call_analyzer

# Option 2: Use individual database variables (for MongoDB Atlas)
DB_CONNECTION=mongodb+srv
DB_HOST=your-db-host.mongodb.net
DB_DATABASE=your-db-name
DB_USERNAME=your-db-username
DB_PASSWORD=your-db-password
DB_PORT=

# File Upload
MAX_FILE_SIZE=10485760          # 10 MB
UPLOAD_DIR=./uploads

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Gemini AI (Backend)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models


#############################################
# 💻 FRONTEND CONFIGURATION (Next.js)
#############################################

# Environment
NEXT_PUBLIC_ENVIRONMENT=development

# Base Path for Deployment
NEXT_PUBLIC_BASE_PATH=/call-analyzer

# API Endpoint (Backend URL)
NEXT_PUBLIC_API_URL=http://localhost:5000/call-analyzer-api

# Cookie Configuration
NEXT_PUBLIC_COOKIE_NAME=weam
NEXT_PUBLIC_COOKIE_PASSWORD=your-random-cookie-password